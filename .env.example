# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# --- Jira (Atlassian) -------------------------------------------------------
# Your Atlassian login email
ATLASSIAN_EMAIL=you@example.edu
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=your-atlassian-token
# Jira Cloud ID of your site
JIRA_CLOUD_ID=00000000-0000-0000-0000-000000000000

# --- Anthropic ---------------------------------------------------------------
# Anthropic API key
ANTHROPIC_API_KEY=your-anthropic-key

# --- Optional ----------------------------------------------------------------
# Models used for drafting and for the side-by-side comparison (--ab)
# DRAFT_MODEL=claude-haiku-5-5
# COMPARE_MODEL=claude-sonnet-5-5
# Pseudonymize names/emails/IDs before each model call (off by default)
# SCRUB_PII_BEFORE_LLM=false
CORPUS_DB_PATH=./.autodrafter/corpus.db
LOG_LEVEL=INFO
